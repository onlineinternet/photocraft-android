<?xml version="1.0" encoding="utf-8"?>
<!--
  PhotoCraft on Android (unofficial). PhotoCraftActivity (java/) is Android's NativeActivity,
  which loads libphotocraft_android.so where android-activity's glue calls `android_main`
  (src/lib.rs), plus the answers of Android's file pickers. Built into an APK by build-apk.sh;
  see README.md beside this folder.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.photocraft.unofficial">
    <!-- No versionCode / versionName here: build-apk.sh sets them (the workspace version and
         the CI run number), and aapt2 won't replace values written in the manifest. -->

    <!-- wgpu prefers Vulkan and falls back to GLES 3. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- No "All files access": files are opened and saved through Android's own pickers. These
         two only matter on Android 9 and 10, for the built-in folder picker. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:label="PhotoCraft (unofficial)"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- configChanges: rotating, folding, resizing or a keyboard arriving must not restart
             the activity, which would end the native app and lose unsaved work. -->
        <activity
            android:name=".PhotoCraftActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale">
            <meta-data android:name="android.app.lib_name" android:value="photocraft_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Images copied or shared to other apps (clipboard, share sheet): read-only cache files,
             readable only through the permission Android grants for that copy or share. -->
        <provider
            android:name=".ImageProvider"
            android:authorities="io.github.photocraft.unofficial.images"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
